{
  "name": "ddrace-automap-rules-syntax",
  "displayName": "DDrace Automap Rules Syntax",
  "description": "Syntax highlighting for DDrace Automap Rules .rules files",
  "version": "0.1.0",
  "publisher": "Entity704",
  "repository": "Entity704/vscode-automap-rules-syntax",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "automapper",
        "extensions": [
          ".rules"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "type": "module",
  "main": "client/out/extension.js",
  "scripts": {
    "compile": "node build.js",
    "build": "npm run compile",
    "package": "mkdir -p releases && vsce package --out ./releases/$(node -p \"require('./package.json').name + '-' + require('./package.json').version + '.vsix'\")"
  },
  "keywords": [],
  "author": "Entity704",
  "license": "MIT",
  "dependencies": {
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
