{
  "name": "tws-automapper-syntax",
  "displayName": "Teeworlds Automapper Syntax",
  "description": "Syntax highlighting for Teeworlds Automapper .rules files",
  "version": "0.0.1",
  "publisher": "Entity",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "automapper",
        "extensions": [
          ".rules"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:automapper"
  ],
  "type": "module",
  "main": "client/out/extension.js",
  "scripts": {
    "compile": "npx tsc -b ./",
    "build": "npm run compile",
    "package": "mkdir -p releases && vsce package --out ./releases/$(node -p \"require('./package.json').name + '-' + require('./package.json').version + '.vsix'\")"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.134.0",
    "typescript": "^7.0.2"
  }
}
