{
  "name": "ddrace-automap-rules-syntax",
  "displayName": "DDrace Automap Rules Syntax",
  "description": "Syntax highlighting for DDrace Automap Rules .rules files",
  "icon": "images/icon.png",
  "version": "0.1.0",
  "publisher": "Entity704",
  "repository": "Entity704/vscode-automap-rules-syntax",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "automapper",
        "extensions": [
          ".rules"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "automapper-controls",
          "title": "Automapper Controls",
          "icon": "images/icon_generic.svg"
        }
      ]
    },
    "configuration": {
      "title": "DDrace Automap Rules",
      "properties": {
        "automapper.randomSeed": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1000000000,
          "description": "用于预览 Random 规则的随机种子"
        }
      }
    },
    "views": {
      "automapper-controls": [
        {
          "id": "automapper-configurations",
          "name": "Configurations",
          "type": "webview",
          "icon": "",
          "visibility": "visible"
        },
        {
          "id": "automapper-rules",
          "name": "Rules",
          "icon": "",
          "visibility": "visible"
        }
      ]
    }
  },
  "type": "module",
  "main": "client/out/extension.js",
  "scripts": {
    "compile": "node build.js",
    "build": "npm run compile",
    "package": "mkdir -p releases && vsce package --out ./releases/$(node -p \"require('./package.json').name + '-' + require('./package.json').version + '.vsix'\")",
    "build-pack": "npm run build && npm run package"
  },
  "keywords": [],
  "author": "Entity704",
  "license": "MIT",
  "dependencies": {
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
