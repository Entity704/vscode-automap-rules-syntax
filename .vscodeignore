# Ignore all files in the root except those explicitly included
*
!.vscodeignore
!package.json
!tsconfig.json
!language-configuration.json
!syntaxes/
!snippets/

# Ignore development directories
.git/
.vscode/
node_modules/
dist/
!out
out/*
!*.js
*.tsbuildinfo

releases/

# Ignore OS files
.DS_Store
Thumbs.db
