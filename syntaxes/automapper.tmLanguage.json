{
  "scopeName": "source.automapper",
  "fileTypes": ["rules"],
  "name": "Teeworlds Automapper",
  "patterns": [
    { "include": "#comments" },
    { "include": "#section-headers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#modifiers" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.automapper", "match": "#.*$" }
      ]
    },
    "section-headers": {
      "patterns": [
        { "name": "entity.name.section.automapper", "match": "^\\[.*\\]$" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.automapper",
          "match": "\\b(Index|Pos|Random|Modulo|NoDefaultRule|NewRun|NoLayerCopy|INDEX|NOTINDEX)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.automapper",
          "match": "\\b(FULL|EMPTY)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "keyword.modifier.automapper",
          "match": "\\b(XFLIP|YFLIP|ROTATE)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.automapper",
          "match": "\\bOR\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.automapper", "match": "\\b\\d+\\b" },
        { "name": "constant.numeric.percentage.automapper", "match": "\\b\\d+%\\b" }
      ]
    }
  }
}
